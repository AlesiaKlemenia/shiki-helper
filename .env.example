# =============================================================================
# Shiki-Helper — шаблон переменных окружения
# Скопируйте файл: cp .env.example .env
# Заполните все обязательные поля перед запуском.
# ВНИМАНИЕ: файл .env не должен попадать в Git!
# =============================================================================

# ---------------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------------
# Получить токен у @BotFather: https://t.me/BotFather
BOT_TOKEN=

# ---------------------------------------------------------------------------
# База данных
# ---------------------------------------------------------------------------
# Вариант 1 — PostgreSQL (Supabase / Neon для деплоя на Render):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
#
# Вариант 2 — SQLite (для локальной разработки):
DATABASE_URL=sqlite+aiosqlite:///./shiki.db

# ---------------------------------------------------------------------------
# Redis (опциональный для FSM Storage диалогов)
# ---------------------------------------------------------------------------
# Если не задан или недоступен — бот автоматически и безопасно работает на
# MemoryStorage (FSM состояния хранятся в памяти и сбрасываются при перезапуске).
# Для продакшена и сохранения состояний между перезапусками задайте REDIS_URL:
#
# Вариант 1 — Локальный Redis (через docker-compose или службу):
# REDIS_URL=redis://localhost:6379/0
#
# Вариант 2 — Upstash Redis (serverless облачный Redis, бесплатно для Render):
# REDIS_URL=rediss://default:<UPSTASH_TOKEN>@<UPSTASH_ENDPOINT>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Шифрование OAuth-токенов
# ---------------------------------------------------------------------------
# Генерация ключа:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Google OAuth 2.0
# ---------------------------------------------------------------------------
# Создать в Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Включить: Google Sheets API, Google Drive API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Командная Google Таблица (субтитры)
# ---------------------------------------------------------------------------
# ID общей таблицы команды (из URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
TEAM_SPREADSHEET_ID=

# ---------------------------------------------------------------------------
# Администрирование
# ---------------------------------------------------------------------------
# Telegram ID администратора (узнать у @userinfobot)
ADMIN_TELEGRAM_ID=

# ---------------------------------------------------------------------------
# Логирование
# ---------------------------------------------------------------------------
# Уровень: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
